@{
    ViewBag.Title = "Login";
}

<h2>Login</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-group">
        @Html.Label("Username")
        @Html.TextBox("username", null, new { @class = "form-control", placeholder = "Enter username" })
    </div>

    <div class="form-group">
        @Html.Label("Password")
        @Html.Password("password", null, new { @class = "form-control", placeholder = "Enter password" })
    </div>

    <button type="submit" class="btn btn-primary">Login</button>
}

<p>
    <a href="@Url.Action("Restaurant", "Register")" class="btn btn-link">Register as Restaurant</a> |
    <a href="@Url.Action("Employee", "Register")" class="btn btn-link">Register as Employee</a>
</p>