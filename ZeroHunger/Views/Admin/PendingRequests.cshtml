@model IEnumerable<ZeroHunger.DTOs.CollectRequestDto>

@{
    ViewBag.Title = "Pending Collect Requests";
}

<h2>Pending Collect Requests</h2>
<table class="table">
    <thead>
        <tr>
            <th>RestaurantId</th>
            <th>Food Description</th>
            <th>Max Preserve Time</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var req in Model)
        {
            <tr>
                <td>@req.RestaurantId</td>
                <td>@req.FoodDescription</td>
                <td>@req.MaxPreserveTime</td>
                <td>@req.Status</td>
                <td>
                    @Html.ActionLink("Assign Employee", "AssignEmployee", new { id = req.Id }, new { @class = "btn btn-primary btn-sm" })
                </td>
            </tr>
        }
    </tbody>
</table>